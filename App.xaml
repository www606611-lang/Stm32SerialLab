<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Stm32SerialLab.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stm32SerialLab">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="LabAccentBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="LabAccentMutedBrush" Color="#1F0F766E" />
            <FontFamily x:Key="LabMonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style x:Key="LabMonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LabMonoFont}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,4" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource LabMonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
