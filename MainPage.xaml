<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Stm32SerialLab.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Stm32SerialLab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Stm32SerialLab.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" Padding="12,8,12,10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScopeMetricColumn.Width" Value="230" />
                        <Setter Target="ConnectionParametersText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScopeMetricColumn.Width" Value="190" />
                        <Setter Target="ConnectionParametersText.Visibility" Value="Collapsed" />
                        <Setter Target="PortComboBox.Width" Value="108" />
                        <Setter Target="BaudComboBox.Width" Value="94" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="ConnectionPanel" Grid.Row="0" Height="40" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="PortComboBox"
                Width="128"
                AutomationProperties.Name="Serial port"
                ItemsSource="{x:Bind PortNames}"
                PlaceholderText="COM port"
                Style="{StaticResource CompactComboBoxStyle}"
                ToolTipService.ToolTip="Serial port" />
            <ComboBox
                x:Name="BaudComboBox"
                Grid.Column="1"
                Width="108"
                AutomationProperties.Name="Baud rate"
                SelectedIndex="4"
                Style="{StaticResource CompactComboBoxStyle}"
                ToolTipService.ToolTip="Baud rate">
                <x:String>9600</x:String>
                <x:String>19200</x:String>
                <x:String>38400</x:String>
                <x:String>57600</x:String>
                <x:String>115200</x:String>
                <x:String>230400</x:String>
                <x:String>460800</x:String>
                <x:String>921600</x:String>
            </ComboBox>
            <TextBlock
                x:Name="ConnectionParametersText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource LabMonoTextStyle}"
                Text="8-N-1" />
            <Button
                Grid.Column="4"
                Width="40"
                AccessKey="R"
                AutomationProperties.Name="Refresh COM ports"
                Click="RefreshPorts_Click"
                Padding="0"
                ToolTipService.ToolTip="Refresh COM ports">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="ConnectButton"
                Grid.Column="5"
                Width="40"
                AccessKey="C"
                AutomationProperties.Name="Connect or disconnect serial port"
                Click="Connect_Click"
                Padding="0"
                ToolTipService.ToolTip="Connect or disconnect">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE768;" />
            </Button>
            <ToggleButton
                x:Name="DemoToggle"
                Grid.Column="6"
                Width="40"
                AutomationProperties.Name="Demo telemetry"
                Click="DemoToggle_Click"
                Padding="0"
                ToolTipService.ToolTip="Generate local FreeRTOS-style telemetry">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE890;" />
            </ToggleButton>
            <Button
                x:Name="ThemeButton"
                Grid.Column="7"
                Width="40"
                AutomationProperties.Name="Switch color theme"
                Click="ThemeButton_Click"
                Padding="0"
                ToolTipService.ToolTip="Switch light and dark theme">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <TabView
            x:Name="WorkspaceTabs"
            Grid.Row="1"
            AddTabButtonClick="WorkspaceTabs_AddTabButtonClick"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsAddTabButtonVisible="False"
            SizeChanged="WorkspaceTabs_SizeChanged"
            TabCloseRequested="WorkspaceTabs_TabCloseRequested"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <TabViewItem Header="Console" HorizontalContentAlignment="Stretch" IsClosable="False" VerticalContentAlignment="Stretch">
                <Grid x:Name="ConsolePanel" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CommandBar
                        Grid.Row="0"
                        Padding="0"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True">
                        <CommandBar.Content>
                            <SelectorBar
                                x:Name="DisplayModeSelector"
                                Margin="0,0,12,0"
                                SelectionChanged="DisplayModeSelector_SelectionChanged">
                                <SelectorBarItem x:Name="AsciiModeItem" Text="ASCII" />
                                <SelectorBarItem x:Name="HexModeItem" Text="HEX" />
                            </SelectorBar>
                        </CommandBar.Content>
                        <AppBarToggleButton
                            x:Name="PauseButton"
                            Click="PauseButton_Click"
                            Icon="Pause"
                            Label="Pause"
                            ToolTipService.ToolTip="Pause the visible timeline" />
                        <AppBarToggleButton
                            x:Name="AutoScrollButton"
                            Icon="Download"
                            IsChecked="True"
                            Label="Auto scroll"
                            ToolTipService.ToolTip="Keep newest traffic visible" />
                        <AppBarButton
                            Click="ClearLog_Click"
                            Icon="Delete"
                            Label="Clear"
                            ToolTipService.ToolTip="Clear traffic log and counters" />
                        <AppBarButton
                            Click="ExportLog_Click"
                            Icon="Save"
                            Label="Export log"
                            ToolTipService.ToolTip="Export raw traffic log" />
                    </CommandBar>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="LogListView"
                            AutomationProperties.Name="Serial traffic timeline"
                            ItemsSource="{x:Bind Logs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="27" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SerialLogEntry">
                                    <Grid MinWidth="680" Padding="8,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource LabMonoTextStyle}"
                                            Text="{x:Bind TimestampText}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Rectangle
                                                Width="3"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind DirectionBrush}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind DirectionBrush}"
                                                Text="{x:Bind DirectionText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource LabMonoTextStyle}"
                                            Text="{x:Bind ByteCount}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            IsTextSelectionEnabled="True"
                                            Style="{StaticResource LabMonoTextStyle}"
                                            Text="{x:Bind DisplayText, Mode=OneWay}"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyLogText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No traffic" />
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="0,8,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="SendModeComboBox"
                                Width="78"
                                AutomationProperties.Name="Send format"
                                SelectedIndex="0"
                                Style="{StaticResource CompactComboBoxStyle}">
                                <x:String>Text</x:String>
                                <x:String>HEX</x:String>
                            </ComboBox>
                            <TextBox
                                x:Name="SendTextBox"
                                Grid.Column="1"
                                AutomationProperties.Name="Serial data to send"
                                KeyDown="SendTextBox_KeyDown"
                                PlaceholderText="Command or bytes" />
                            <ComboBox
                                x:Name="LineEndingComboBox"
                                Grid.Column="2"
                                Width="86"
                                AutomationProperties.Name="Line ending"
                                SelectedIndex="2"
                                Style="{StaticResource CompactComboBoxStyle}">
                                <x:String>None</x:String>
                                <x:String>\n</x:String>
                                <x:String>\r\n</x:String>
                                <x:String>\r</x:String>
                            </ComboBox>
                            <Button
                                Grid.Column="3"
                                AccessKey="S"
                                Click="Send_Click"
                                ToolTipService.ToolTip="Send (Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <SymbolIcon Symbol="Send" />
                                    <TextBlock Text="Send" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Scope" HorizontalContentAlignment="Stretch" IsClosable="False" VerticalContentAlignment="Stretch">
                <Grid x:Name="ScopePanel" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="ScopeMetricColumn" Width="230" />
                    </Grid.ColumnDefinitions>
                    <CommandBar
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Padding="0"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True">
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" Text="Time" />
                                <Slider
                                    x:Name="TimeWindowSlider"
                                    Width="112"
                                    AutomationProperties.Name="Scope time window"
                                    Maximum="11"
                                    Minimum="0"
                                    StepFrequency="1"
                                    ToolTipService.ToolTip="Visible time window: 100 ms to 300 s"
                                    Value="6"
                                    ValueChanged="TimeWindowSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="TimeWindowText"
                                    Width="46"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabMonoTextStyle}"
                                    Text="10 s" />
                                <Rectangle Width="1" Height="22" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="Gain" />
                                <Slider
                                    x:Name="VerticalGainSlider"
                                    Width="84"
                                    AutomationProperties.Name="Scope vertical gain"
                                    IsEnabled="False"
                                    Maximum="10"
                                    Minimum="0"
                                    StepFrequency="1"
                                    ToolTipService.ToolTip="Vertical waveform scale: 1/16x to 64x"
                                    Value="4"
                                    ValueChanged="VerticalGainSlider_ValueChanged" />
                                <TextBlock
                                    x:Name="VerticalGainText"
                                    Width="36"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabMonoTextStyle}"
                                    Text="1x" />
                                <DropDownButton
                                    x:Name="AutoYModeButton"
                                    MinWidth="90"
                                    AutomationProperties.Name="Y axis mode Follow"
                                    Content="Auto: Follow"
                                    ToolTipService.ToolTip="Choose automatic or manual Y-axis behavior">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Click="YAxisFollow_Click" Text="Follow" />
                                            <MenuFlyoutItem Click="YAxisFitOnce_Click" Text="Fit once" />
                                            <MenuFlyoutItem Click="YAxisFullRange_Click" Text="Full range" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="YAxisManual_Click" Text="Manual" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <TextBlock
                                    x:Name="ScopeModeText"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource LabAccentBrush}"
                                    FontWeight="SemiBold"
                                    Text="LIVE" />
                            </StackPanel>
                        </CommandBar.Content>
                        <AppBarToggleButton
                            x:Name="ScopeHoldButton"
                            Click="ScopeHoldButton_Click"
                            Icon="Pause"
                            Label="Hold"
                            ToolTipService.ToolTip="Hold the current time position" />
                        <AppBarButton
                            Click="ScopeLiveButton_Click"
                            Icon="Play"
                            Label="Live"
                            ToolTipService.ToolTip="Return to the live edge" />
                        <AppBarButton
                            Click="ScopeResetButton_Click"
                            Icon="Refresh"
                            Label="Reset view"
                            ToolTipService.ToolTip="Reset time window, gain, and position" />
                    </CommandBar>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Canvas
                                x:Name="ScopeCanvas"
                                AutomationProperties.Name="Telemetry waveform"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                PointerCaptureLost="ScopeCanvas_PointerCaptureLost"
                                PointerMoved="ScopeCanvas_PointerMoved"
                                PointerPressed="ScopeCanvas_PointerPressed"
                                PointerReleased="ScopeCanvas_PointerReleased"
                                PointerWheelChanged="ScopeCanvas_PointerWheelChanged"
                                SizeChanged="ScopeCanvas_SizeChanged" />
                        </Border>
                        <TextBlock
                            x:Name="PlotEmptyText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No numeric samples" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Channels" />
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind Metrics}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="32" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TelemetryMetric">
                                    <Grid Padding="2,5" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind DisplayName}"
                                            IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Fill="{x:Bind Stroke}" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource LabMonoTextStyle}"
                                                Text="{x:Bind LatestText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            Click="ExportTelemetry_Click"
                            ToolTipService.ToolTip="Export waveform samples as CSV">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="Export CSV" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Telemetry" HorizontalContentAlignment="Stretch" IsClosable="False" VerticalContentAlignment="Stretch">
                <Grid x:Name="TelemetryPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Padding="12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Channel" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Latest" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Minimum" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Maximum" />
                            <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="Samples" />
                        </Grid>
                    </Border>
                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind Metrics}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TelemetryMetric">
                                <Grid Padding="12,5" ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox AutomationProperties.Name="{x:Bind DisplayName}" IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Rectangle Width="3" Height="16" VerticalAlignment="Center" Fill="{x:Bind Stroke}" />
                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource MetricValueStyle}" Text="{x:Bind LatestText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource MetricValueStyle}" Text="{x:Bind MinimumText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource MetricValueStyle}" Text="{x:Bind MaximumText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource MetricValueStyle}" Text="{x:Bind SampleCountText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="ConnectionStatusText" VerticalAlignment="Center" Text="DISCONNECTED" />
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LabMonoTextStyle}" Text="{x:Bind RxStatusText, Mode=OneWay}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource LabMonoTextStyle}" Text="{x:Bind TxStatusText, Mode=OneWay}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource LabMonoTextStyle}" Text="{x:Bind LineStatusText, Mode=OneWay}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource LabMonoTextStyle}" Text="{x:Bind ErrorStatusText, Mode=OneWay}" />
            <TextBlock
                x:Name="TransientStatusText"
                Grid.Column="6"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Ready" />
        </Grid>
    </Grid>
</Page>
